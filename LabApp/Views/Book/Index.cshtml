@model List<Book>

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}

<h2>Lista książek</h2>

<table class="table">
    <thead>
    <th>
        Tytuł
    </th>
    <th>
        Cena
    </th>
    </thead>
    
    <tbody>
    @{
        foreach (var book in @Model)
        { 
         
        <partial model="@book name="_BookRow"/>
            
        }
    }
    </tbody>


</table>